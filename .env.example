# Coolify & Production Environment Configuration
# All values below have automatic defaults in docker-compose.yaml for zero-config Coolify deployment.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ADMIN_URL=admin/
DJANGO_ADMIN_EMAIL=demo@shawon.me
DJANGO_ADMIN_PASSWORD=demo1234
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SERVE_MEDIA=True
DJANGO_AUTO_IMPORT_LEGACY=True
DJANGO_AUTO_BACKUP_ON_START=True
DJANGO_AUTO_BACKUP_INTERVAL=86400
DJANGO_BACKUP_RETENTION_COUNT=7
